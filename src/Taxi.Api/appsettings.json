{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "TaxiServer",
    "Audience": "TaxiClient",
    "TokenExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 7
  },
  "Seed": {
    "Admin": {
      "Email": "",
      "Password": ""
    },
    "SampleData": false
  },
  "AppSettings": {
    "CorsPolicyName": "TaxiCorsPolicy",
    "AllowedOrigins": [
      "http://localhost:5002",
      "https://localhost:7008"
    ],
    "DefaultLanguage": "en"
  },
  "ForwardedHeaders": {
    "ForwardedHeaders": "XForwardedFor, XForwardedProto, XForwardedHost",
    "ForwardLimit": 1,
    "AllowAllInDevelopment": false,
    "KnownProxies": [],
    "KnownIPNetworks": []
  },
  "RateLimiting": {
    "Default": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 10
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "AllowedHosts": "*"
}