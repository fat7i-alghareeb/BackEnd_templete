# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_very_strong_password_here

# Redis (HybridCache L2)
REDIS_PASSWORD=generate_a_strong_redis_password

# API Secrets
JWT_SECRET=generate_a_very_long_and_secure_jwt_secret_key

# Outgoing email (production compose uses SMTP; development uses the Mailpit container)
EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional bootstrap Manager account (production compose). Leave empty to seed no user;
# remove both values once the account exists and its password has been rotated.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Grafana
GRAFANA_ADMIN_PASSWORD=generate_grafana_admin_password
